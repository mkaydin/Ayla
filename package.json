{
  "name": "ayla-ai-assistant",
  "version": "0.1.0",
  "description": "Ayla local AI coworker with a Live2D interface and persistent knowledge memory",
  "author": {
    "name": "Ayla Project",
    "email": "noreply@localhost"
  },
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "desktopName": "com.ayla.coworker.chromium",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node --test tests/*.test.js",
    "check": "npm run test && npm run build",
    "preview": "vite preview",
    "tauri": "npx tauri",
    "electron:dev": "npm run sidecar:build && node electron/dev.mjs",
    "electron:start": "npm run sidecar:build && electron electron/main.mjs",
    "electron:stage": "npm run build && npm run sidecar:build:release && node electron/stage-resources.mjs",
    "electron:pack": "npm run electron:stage && electron-builder --config electron-builder.yml --dir && npm run electron:inspect",
    "electron:build": "npm run electron:stage && electron-builder --config electron-builder.yml && npm run electron:inspect",
    "electron:inspect": "node electron/inspect-package.mjs",
    "sidecar:build": "cargo build --manifest-path crates/alice-sidecar/Cargo.toml",
    "sidecar:build:release": "cargo build --release --manifest-path crates/alice-sidecar/Cargo.toml",
    "sidecar:diagnostic": "node electron/sidecar-diagnostic.mjs",
    "sidecar:diagnostic:live": "node electron/sidecar-live-diagnostic.mjs",
    "sidecar:diagnostic:mutations": "node electron/sidecar-mutation-diagnostic.mjs",
    "sidecar:diagnostic:features": "node electron/sidecar-feature-diagnostic.mjs",
    "sidecar:diagnostic:ocr": "node electron/sidecar-ocr-diagnostic.mjs"
  },
  "dependencies": {
    "@pixi/unsafe-eval": "^6.5.10",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/cli": "^2.11.4",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "dompurify": "^3.2.0",
    "highlight.js": "^11.11.1",
    "katex": "^0.18.1",
    "marked": "^18.0.6",
    "pixi-live2d-display": "^0.4.0",
    "pixi.js": "^6.5.10"
  },
  "devDependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "electron": "41.6.1",
    "electron-builder": "^26.15.3",
    "vite": "^5.4.10"
  },
  "allowScripts": {
    "electron@41.6.1": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.21.5": true
  }
}
