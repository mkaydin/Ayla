# Copy this file to .env and fill in real values. NEVER commit your real .env.
# (The .env file is gitignored.)

# SurrealDB credentials (issue I1/R5). Generate a strong password.
SURREAL_USER=root
SURREAL_PASS=change-me-to-a-long-random-string

# SearXNG session signing secret (issue I2). Generate with: openssl rand -hex 32
SEARXNG_SECRET=change-me-to-a-64-hex-char-random-string
SEARXNG_URL=http://127.0.0.1:8888
AYLA_LIGHTPANDA_URL=ws://127.0.0.1:9222

# Maximum Ollama context window. Each request automatically selects 8K, 16K,
# or 32K based on its prompt and output budget. 32768 is tuned for an 8 GB GPU.
AYLA_OLLAMA_NUM_CTX=32768
# Long LLM operations have no total timeout by default. Keep 0 for slow local
# hardware/cloud models, or set a limit in seconds. Transient failures retry.
AYLA_OLLAMA_LONG_TIMEOUT_SECS=0
AYLA_OLLAMA_TRANSPORT_RETRIES=3
# Ollama text model. Keep Gemma as the default, or use another installed/cloud model.
# AYLA_LLM_MODEL=gemma4:e4b
# Research may select a separate model; when unset it inherits AYLA_LLM_MODEL.
# AYLA_RESEARCH_MODEL=nemotron-3-super:cloud
# Sends your topic and selected public source evidence to that cloud model.
AYLA_RESEARCH_ALLOW_CLOUD=false
# Semantic code analysis uses its own model and never inherits AYLA_LLM_MODEL.
# AYLA_CODE_ANALYSIS_MODEL=gemma4:e4b
# Explicitly opt in before using an Ollama model tagged `:cloud` for code analysis.
AYLA_CODE_ANALYSIS_ALLOW_CLOUD=false
# OCR vision model used by the in-process PDF OCR engine.
# AYLA_OCR_MODEL=glm-ocr:latest
# AYLA_OCR_PARALLEL=1
# AYLA_OCR_NUM_CTX=8192
# Completed pages are cached privately and reused when an interrupted document is retried.
# AYLA_OCR_RESUME_CACHE=true
# AYLA_OCR_CACHE_DIR=/absolute/path/to/ayla-data/ocr-page-cache
# KB modes: disabled, deterministic (default), or semantic. Semantic mode uses
# the configured loopback Ollama endpoint and falls back to deterministic output.
# AYLA_OCR_KB_MODE=deterministic
# OCR semantic assembly never inherits AYLA_LLM_MODEL. Local models are allowed
# by default. A `:cloud` model additionally requires the explicit consent flag.
# AYLA_OCR_ASSEMBLY_MODEL=nemotron-3-super:cloud
AYLA_OCR_ASSEMBLY_ALLOW_CLOUD=false

# Offline speech synthesis. `auto` prefers bundled Supertonic F1 and falls back
# to Piper; use `piper` as a temporary rollback option.
AYLA_TTS_ENGINE=auto
# Default voice language. The bundled Supertonic model supports both `tr` and `en`.
AYLA_TTS_LANGUAGE=tr
AYLA_TTS_THREADS=4
AYLA_TTS_STEPS=8
AYLA_TTS_SPEED=1.0
# AYLA_TTS_MODEL_DIR=/absolute/path/to/a/compatible/model-directory

# Local dictation uses the bundled CPU INT8 Omnilingual ASR and renderer audio
# capture. It automatically recognizes Turkish and English. The system-level
# listener is off by default; manual Chat dictation remains available.
AYLA_STT_SYSTEM_ENABLED=false
AYLA_STT_THREADS=4
AYLA_STT_VAD_THRESHOLD=0.5
AYLA_STT_MIN_SILENCE_SECONDS=0.5
AYLA_STT_PARTIAL_INTERVAL_SECONDS=0.5
# AYLA_STT_MODEL_DIR=/absolute/path/to/models/stt

# Snapshot restoration can select an isolated vector namespace.
# AYLA_QDRANT_COLLECTION_PREFIX=restored_
# QDRANT_HTTP_URL=http://127.0.0.1:6333
