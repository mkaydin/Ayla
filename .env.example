# Copy this file to .env and fill in real values. NEVER commit your real .env.
# (The .env file is gitignored.)

# SurrealDB credentials (issue I1/R5). Generate a strong password.
SURREAL_USER=root
SURREAL_PASS=change-me-to-a-long-random-string

# SearXNG session signing secret (issue I2). Generate with: openssl rand -hex 32
SEARXNG_SECRET=change-me-to-a-64-hex-char-random-string
